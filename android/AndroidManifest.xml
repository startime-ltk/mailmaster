<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mailmaster.android"
    android:versionCode="11"
    android:versionName="1.10">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 安卓 8+ 安装 APK 所需权限（旧系统忽略） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ComposeActivity"
            android:exported="false" />

        <activity
            android:name=".MessageActivity"
            android:exported="false" />

        <!-- 附件分享：把私有目录里的附件以 content:// 临时授权给外部 App 打开 -->
        <provider
            android:name=".AttachmentProvider"
            android:authorities="com.mailmaster.android.attachments"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- 应用内更新：把下载的 APK 临时授权给系统安装器 -->
        <provider
            android:name=".UpdateProvider"
            android:authorities="com.mailmaster.android.update"
            android:exported="false"
            android:grantUriPermissions="true" />

    </application>
</manifest>
