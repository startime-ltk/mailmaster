<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <android.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            android:background="@drawable/bg_toolbar"
        android:elevation="4dp"
        android:contentInsetStart="0dp"
        android:contentInsetLeft="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="6dp"
            android:paddingRight="16dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_back_white"
                android:scaleType="center"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/content_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:text="@string/bar_title_compose"
                android:textColor="@color/on_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>
    </android.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- 发件账户 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/bg_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_from"
                    android:textColor="@color/sub"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spinner_from"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- 收件人 / 主题 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:padding="12dp"
                android:background="@drawable/bg_card">

                <EditText
                    android:id="@+id/et_to"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_to"
                    android:inputType="textEmailAddress"
                    android:background="@android:color/transparent"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@color/divider" />

                <EditText
                    android:id="@+id/et_subject"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_subject"
                    android:background="@android:color/transparent"
                    android:textSize="15sp" />

            </LinearLayout>

            <!-- 附件操作 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp"
                android:padding="12dp"
                android:background="@drawable/bg_card">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_attach_gray"
                    android:contentDescription="@string/btn_attach" />

                <TextView
                    android:id="@+id/tv_attachments"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="10dp"
                    android:textSize="13sp"
                    android:textColor="@color/sub"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <Button
                    android:id="@+id/btn_attach"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/btn_attach"
                    android:textSize="13sp"
                    android:textColor="@color/primary"
                    android:background="@drawable/btn_outline" />

                <TextView
                    android:id="@+id/btn_clear_attach"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:padding="6dp"
                    android:text="@string/btn_clear_attach"
                    android:textSize="13sp"
                    android:textColor="@color/sub"
                    android:background="?android:attr/selectableItemBackground"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- 正文 -->
            <EditText
                android:id="@+id/et_body"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minLines="5"
                android:layout_marginTop="10dp"
                android:hint="@string/hint_body"
                android:gravity="top"
                android:padding="12dp"
                android:textSize="15sp"
                android:lineSpacingExtra="3dp"
                android:background="@drawable/bg_card" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginLeft="14dp"
        android:layout_marginRight="14dp"
        android:layout_marginBottom="14dp">

        <Button
            android:id="@+id/btn_save_draft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/btn_save_draft"
            android:textSize="15sp"
            android:textColor="@color/primary"
            android:background="@drawable/btn_outline" />

        <Button
            android:id="@+id/btn_send"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            android:drawableStart="@drawable/ic_arrow_right_white"
            android:drawablePadding="8dp"
            android:padding="12dp"
            android:text="@string/btn_send"
            android:textColor="@color/on_primary"
            android:textSize="16sp"
            android:background="@drawable/btn_primary" />

    </LinearLayout>

</LinearLayout>
